# 0 - debug, 1 - info, 2 - warn, 3 - error
SYSTEM_LOG_LEVEL=1
# Host network binds this on the server itself. Keep it on localhost.
HEALTH_ADDR=127.0.0.1:19090
DATA_DIR=/data

PROBE_INTERVAL=1m
PROBE_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
GATEWAY_PROBE=true
PING_COUNT=10
PING_INTERVAL=200ms
TCP_PORT=443
TCP_TIMEOUT=2s
# Empty: interface of the default route.
IFACE=

INCIDENT_LOSS_PCT=1
INCIDENT_RTT_FACTOR=3
INCIDENT_RTT_FLOOR=50ms
INCIDENT_COOLDOWN=10m

RETENTION=24h
CLEANUP_INTERVAL=1h

# Short sample. Full 8s means throughput was about 32 Mbit/s or less.
# A fast link hits the byte cap and stops sooner.
SPEEDTEST_INTERVAL=30m
SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=100000000
SPEEDTEST_MAX_DURATION=8s
SPEEDTEST_MAX_BYTES=33554432
